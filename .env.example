# Copy to .env (never commit .env) and fill in. Used by compose.yaml.

# Token of the Cloudflare named tunnel (Zero Trust -> Networks -> Tunnels -> your tunnel).
# Only for the container tunnel (`docker compose --profile tunnel up -d`); leave empty when the
# server's own cloudflared routes the hostname to http://127.0.0.1:8101.
TUNNEL_TOKEN=

# Where the private folder and test results live on the server (owned by uid 10001, see docs/home-server.md).
LSPCARE_DATA=./data

# Local time for transcripts and tickets.
TZ=Australia/Adelaide

# Set when building so every call records the exact code version:
#   GIT_COMMIT=$(git rev-parse --short HEAD) docker compose up -d --build
# GIT_COMMIT=

# --- Dashboard sign-in ---
# Comma-separated list of Host headers the dashboard will serve. Add the public hostname; keep
# localhost and 127.0.0.1 for the SSH-tunnel path and health checks.
DASHBOARD_HOSTS=localhost:8102,127.0.0.1:8102
# Secret for signing session cookies. 32+ random bytes, base64. Generate once:
#   head -c 32 /dev/urandom | base64
# Changing this value signs everyone out on the next restart.
DASHBOARD_SESSION_SECRET=
# One password per role. Pick strong passwords and share them with staff privately (Vaultwarden).
# Rotating a password requires a container restart (`docker compose up -d dashboard`).
DASHBOARD_PASSWORD_ADMIN=
DASHBOARD_PASSWORD_REVIEWER=
DASHBOARD_PASSWORD_READER=
